{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2023",
    "strict": true,
    "esModuleInterop": true,
    "ignoreDeprecations": "6.0",
    "skipLibCheck": true,

    "rootDir": "api",
    "outDir": "dist",
    "types": ["node"],
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,

    "baseUrl": ".",
    "paths": {
      "@api/*": ["api/*"],
      "@core/*": ["core/*"]
    }
  },
  "include": ["api/**/*"],
  "exclude": ["**/*.spec.ts", "dist", "node_modules"]
}
